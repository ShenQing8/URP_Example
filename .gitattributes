# Normalize line endings: store LF in the repository, check out native EOL on Windows.
* text=auto

# Unity text-based assets (kept as LF in the repository)
*.cs            text
*.meta          text
*.unity         text
*.prefab        text
*.asset         text
*.mat           text
*.anim          text
*.controller    text
*.overrideController text
*.physicMaterial text
*.shader        text
*.shadergraph   text
*.shadersubgraph text
*.compute       text
*.hlsl          text
*.cginc         text
*.uss           text
*.uxml          text
*.asmdef        text
*.inputactions  text
*.json          text
*.txt           text
*.md            text
*.slnx          text

# Binary assets - never convert or diff
