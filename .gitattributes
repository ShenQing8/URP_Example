*.tif           binary
*.tiff          binary
*.psd           binary
*.exr           binary
*.hdr           binary
*.fbx           binary
*.obj           binary
*.blend         binary
*.wav           binary
*.mp3           binary
*.ogg           binary
*.dll           binary
*.so            binary
*.dylib         binary
*.a             binary
*.bundle        binary
*.unitypackage  binary
