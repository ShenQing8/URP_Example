#pragma kernel CSMain
float4 _FrustumPlanes[6]; // Normalized world-space planes for both projection types.
float3 _CameraPositionWS;
float _MaxDrawDistance, _DeformationRadius;
uint _StartOffset, _JobLength, _TotalCount;
StructuredBuffer<float3> _AllInstancesPosWSBuffer;
AppendStructuredBuffer<uint> _VisibleInstancesOnlyPosWSIDBuffer;
[numthreads(64, 1, 1)]
void CSMain(uint3 thread : SV_DispatchThreadID)
{
    if (thread.x >= _JobLength || _StartOffset >= _TotalCount || thread.x >= _TotalCount - _StartOffset) return;
    uint id = _StartOffset + thread.x;
    float3 position = _AllInstancesPosWSBuffer[id];
    if (distance(position, _CameraPositionWS) > _MaxDrawDistance + _DeformationRadius) return;
    [unroll] for (uint i = 0; i < 6; i++)
        if (dot(_FrustumPlanes[i].xyz, position) + _FrustumPlanes[i].w < -_DeformationRadius) return;
    _VisibleInstancesOnlyPosWSIDBuffer.Append(id);
}
